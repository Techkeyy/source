# Required for real authentication and persistence
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=source
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required for live URL profile analysis. The server only reads this key.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Select exactly one server-side inference route after owner approval.
# The initial OpenRouter activation is explicitly the free model. Source reads
# this value and never silently substitutes the paid standard model.
INFERENCE_PROVIDER=openrouter-gemma
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Direct Google Gemma remains available for diagnosis only when explicitly
# selected with INFERENCE_PROVIDER=gemma.
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# DeepSeek is the owner-approved fallback after the OpenRouter time-box.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional broader discovery and observability
SERPAPI_KEY=
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
